# Zelfde Supabase-project als de Recepten-app en de Tuin-app (een login voor alles).
EXPO_PUBLIC_SUPABASE_URL=https://<project_ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
# Publieke VAPID-sleutel voor meldingen (de privesleutel staat enkel in Vercel als VAPID_PRIVATE_KEY).
EXPO_PUBLIC_VAPID_PUBLIC_KEY=<publieke-vapid-sleutel>
